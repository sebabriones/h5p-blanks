            "min": 0,
            "max": 5000,
            "step": 50,
            "unit": "ms"
          },
          {
            "name": "tabDuration",
            "type": "number",
            "label": "Tab open/close duration",
            "description": "Opening/closing speed for the instructions tab in milliseconds.",
            "default": 600,
            "min": 0,
            "max": 5000,
            "step": 50,
            "unit": "ms"
